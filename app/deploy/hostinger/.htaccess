# Value Attendance (Flutter Web) — https://jaurea.com/value-attendance/
# This file lives ONLY in public_html/value-attendance/ and applies to this folder only.
# The WordPress site and its root .htaccess are not touched.

Options -Indexes
DirectoryIndex index.html

# --- routing: real files are served as they are; any other path inside this folder opens the app
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /value-attendance/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- file types
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .mjs
  AddType image/webp .webp
  AddType audio/mpeg .mp3
  AddType font/otf .otf
  AddType font/ttf .ttf
  AddType application/json .json
  AddType application/vnd.android.package-archive .apk
</IfModule>

# --- compression (text files; images / audio are already compressed)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript text/javascript application/json application/wasm font/otf font/ttf image/svg+xml
</IfModule>

# --- caching
# App code (.js / .mjs / .wasm), the page itself and the Android update (android/latest.json + .apk): always re-checked (cheap 304 when unchanged) so a new deploy shows at once.
# The fonts too: the icon font keeps its name but changes with every build that uses a new icon.
# Images too (a picture can be replaced under the same name, e.g. the backdrop). Only icons and sounds are kept 7 days.
# No API data is served from here — the API lives on its own host and is never cached by this file.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(html|js|mjs|json|webmanifest|wasm|apk|ttf|otf|woff|woff2|webp|png|jpg|jpeg|gif|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(ico|mp3|wav)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# never serve hidden / leftover files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

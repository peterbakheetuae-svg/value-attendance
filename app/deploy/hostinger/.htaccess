# Value Attendance (Flutter Web) — https://jaurea.com/valunivo/
# This file lives ONLY in public_html/valunivo/ and applies to this folder only.
# The WordPress site and its root .htaccess are not touched.

Options -Indexes
DirectoryIndex index.html

# --- routing: real files are served as they are; any other path inside this folder opens the app
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /valunivo/
  # http → https, forced here too. Loop-safe behind the host's proxy: only when neither Apache nor the proxy saw https.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- file types
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .mjs
  AddType image/webp .webp
  AddType audio/mpeg .mp3
  AddType font/otf .otf
  AddType font/ttf .ttf
  AddType application/json .json
  AddType application/vnd.android.package-archive .apk
</IfModule>

# --- compression (text files; images / audio are already compressed)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript text/javascript application/json application/wasm font/otf font/ttf image/svg+xml
</IfModule>

# --- caching
# App code (.js / .mjs / .wasm), the page itself and the Android update (android/latest.json + .apk): always re-checked (cheap 304 when unchanged) so a new deploy shows at once.
# The fonts too: the icon font keeps its name but changes with every build that uses a new icon.
# Images too (a picture can be replaced under the same name, e.g. the backdrop). Only icons and sounds are kept 7 days.
# No API data is served from here — the API lives on its own host and is never cached by this file.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # --- security headers (VA-08)
  # HSTS: the browser keeps using https for this host (no includeSubDomains / preload — those would bind the whole domain)
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
  # Enforced (2026-11-25, after the live report-only check: the only report was the loader's inline script, now the file
  # va-loader.js). Flutter's wasm renderer needs 'wasm-unsafe-eval' and loads its engine from www.gstatic.com; map tiles come
  # from tile.openstreetmap.org; the API, its second domain and the Cloudflare mirror are the only other connections.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://valunivo.vercel.app https://value-attendance.vercel.app https://value-attendance-api.peter-bakheet-uae.workers.dev https://www.gstatic.com https://fonts.gstatic.com https://fcm.googleapis.com https://firebaseinstallations.googleapis.com https://tile.openstreetmap.org; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
  <FilesMatch "\.(html|js|mjs|json|webmanifest|wasm|apk|ttf|otf|woff|woff2|webp|png|jpg|jpeg|gif|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(ico|mp3|wav)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# never serve hidden / leftover files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# nor source maps, sources, backups, logs or config left over by a build
<FilesMatch "\.(map|dart|ts|yaml|yml|lock|bak|old|orig|swp|sql|log|ini|env|sh|php)$">
  Require all denied
</FilesMatch>


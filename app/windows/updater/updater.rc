#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VALUNIVO_VERSION_NUMBER
 PRODUCTVERSION VALUNIVO_VERSION_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Value Group\0"
            VALUE "FileDescription", "VALUNIVO update helper\0"
            VALUE "FileVersion", VALUNIVO_VERSION_STRING "\0"
            VALUE "InternalName", "VALUNIVO-Updater\0"
            VALUE "OriginalFilename", "VALUNIVO-Updater.exe\0"
            VALUE "ProductName", "VALUNIVO\0"
            VALUE "ProductVersion", VALUNIVO_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

// Cloudflare gateway — STAGING. See cloudflare/gateway.ts and docs/CLOUDFLARE_HYBRID_ARCHITECTURE.md.
// ISOLATED: the upstream is the synthetic verifier Worker (Service Binding), NOT Vercel and NOT any production host.
// UPSTREAM is a reserved .invalid name that can never resolve, so even without the binding nothing leaves Cloudflare.
// No database binding, no Hyperdrive, no routes / custom domain (workers.dev only), no secrets in this file.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "valunivo-gateway-staging",
  "main": "cloudflare/gateway.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Workers Logs off: invocation logs would record request URLs (query strings). Nothing from requests is logged.
  "observability": { "enabled": false },
  "vars": {
    "UPSTREAM": "https://verifier.staging.invalid"
  },
  "services": [
    { "binding": "UPSTREAM_SERVICE", "service": "valunivo-gw-verifier-staging" }
  ]
}

{
  "name": "value-attendance-api",
  "version": "0.1.0",
  "private": true,
  "description": "Value Attendance — single-company HR & sales management API",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "start:prod": "node scripts/migrate-if-production.mjs && node --import tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "seed:dev": "tsx src/seed-dev.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test --test-concurrency=4 test/*.test.ts"
  },
  "dependencies": {
    "nodemailer": "^10.6.1",
    "pg": "^8.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "esbuild": ">=0.23.0",
    "typescript": "^7.0.2"
  }
}

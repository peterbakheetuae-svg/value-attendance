{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd api && npm install",
  "buildCommand": "cd api && node scripts/migrate-if-production.mjs && node scripts/vercel-build.mjs ../.vercel/output",
  "outputDirectory": "api/public",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false,
      "release-review/phase6-v4": false,
      "release-prep/phase6-v4-085-baseline": false,
      "release-prep/final-business-model": false,
      "release-prep/integration-2026-11-23": false,
      "feature/ui-sales-commission-2026-11-24": false,
      "feat/marketing-intelligence": false
    }
  }
}
